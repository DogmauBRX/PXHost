[Unit]
Description=GXhost WireGuard game-port DNAT
After=network-online.target wg-quick@wg0.service docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/gxhost-agent/game-dnat.env
ExecStart=/usr/local/sbin/gxhost-game-dnat.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
