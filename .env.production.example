# Deploy plan — production env for docker-compose.prod.yml. Copy to
# `.env` on the VPS (never commit the real file — it holds live secrets)
# and fill in every value below. Two kinds of variable live here:
# compose-level (consumed by docker-compose.prod.yml itself, e.g.
# POSTGRES_PASSWORD) and app-level (passed through via `env_file: .env`
# on the api/worker services, validated by apps/api/src/core/config/
# env.schema.ts — see apps/api/.env.example for the full documented
# list; only the production-specific values are repeated here).

# ---- compose-level: datastore container credentials ----
POSTGRES_PASSWORD=
MARIADB_ROOT_PASSWORD=

# ---- app-level: apps/api/src/core/config/env.schema.ts ----
NODE_ENV=production
PORT=3000

# IMPORTANT — migration 0002_rls_policies creates the `app_user` Postgres
# role itself, with a HARDCODED password ('pxhost_app_dev') meant only
# for local dev. After the FIRST `prisma migrate deploy` against this
# production database, rotate it before ever pointing real traffic here:
#   ALTER ROLE app_user WITH PASSWORD '<a real random password>';
# then set DATABASE_URL below to match. DIRECT_DATABASE_URL uses the
# table-owner role instead (POSTGRES_USER=gxhost above) — only
# `prisma migrate` ever connects with it, never the running app.
DATABASE_URL=postgresql://app_user:<rotated-password>@postgres:5432/gxhost?schema=public
DIRECT_DATABASE_URL=postgresql://gxhost:${POSTGRES_PASSWORD}@postgres:5432/gxhost?schema=public

REDIS_URL=redis://redis:6379
QUEUE_REDIS_URL=redis://redis:6379/1

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=
APP_KEY_VERSION=1
JWT_SESSION_SECRET=

# base64 of a Go-format ed25519.PrivateKey — see apps/api/.env.example
# for how to generate it. The matching .pub goes on every node as
# panel_public_key_path (node.json).
PANEL_ED25519_PRIVATE_KEY=

# Same registrable domain (gxhost.com.br) as the panel, on the OTHER
# subdomain — required for the refresh cookie's SameSite=Lax to work
# across the two origins. Never localhost in production.
PANEL_URL=https://gxhost.com.br
CORS_ORIGIN=https://gxhost.com.br
PUBLIC_SITE_URL=https://gxhost.com.br

BILLING_WEBHOOK_SECRET=

ASSISTANT_PROVIDER=kb
ASSISTANT_LLM_API_KEY=

# Without these, password-reset emails only get logged by the API
# (MailService's degrade-gracefully fallback) instead of actually sent —
# fine for a soft launch, but worth setting before real customers rely
# on "esqueci minha senha".
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@gxhost.com.br
MAIL_FROM_NAME=GXhost

ALLOW_PUBLIC_REGISTRATION=false
