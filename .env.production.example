# Deploy plan — production env for docker-compose.prod.yml. Copy to
# `.env` on the VPS (never commit the real file — it holds live secrets)
# and fill in every value below. Two kinds of variable live here:
# compose-level (consumed by docker-compose.prod.yml itself, e.g.
# POSTGRES_PASSWORD) and app-level (passed through via `env_file: .env`
# on the api/worker services, validated by apps/api/src/core/config/
# env.schema.ts — see apps/api/.env.example for the full documented
# list; only the production-specific values are repeated here).

# ---- compose-level: datastore container credentials ----
POSTGRES_PASSWORD=
MARIADB_ROOT_PASSWORD=

# ---- app-level: apps/api/src/core/config/env.schema.ts ----
NODE_ENV=production
PORT=3000

# IMPORTANT — migration 0002_rls_policies creates the `app_user` Postgres
# role itself, with a HARDCODED password ('pxhost_app_dev') meant only
# for local dev. After the FIRST `prisma migrate deploy` against this
# production database, rotate it before ever pointing real traffic here:
#   ALTER ROLE app_user WITH PASSWORD '<a real random password>';
# then set DATABASE_URL below to match. DIRECT_DATABASE_URL uses the
# table-owner role instead (POSTGRES_USER=gxhost above) — only
# `prisma migrate` ever connects with it, never the running app.
DATABASE_URL=postgresql://app_user:<rotated-password>@postgres:5432/gxhost?schema=public
DIRECT_DATABASE_URL=postgresql://gxhost:${POSTGRES_PASSWORD}@postgres:5432/gxhost?schema=public

REDIS_URL=redis://redis:6379
QUEUE_REDIS_URL=redis://redis:6379/1

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=
APP_KEY_VERSION=1
JWT_SESSION_SECRET=

# base64 of a Go-format ed25519.PrivateKey — see apps/api/.env.example
# for how to generate it. The matching .pub goes on every node as
# panel_public_key_path (node.json).
PANEL_ED25519_PRIVATE_KEY=

# Same registrable domain (gxhost.com.br) as the panel, on the OTHER
# subdomain — required for the refresh cookie's SameSite=Lax to work
# across the two origins. Never localhost in production.
PANEL_URL=https://gxhost.com.br
CORS_ORIGIN=https://gxhost.com.br
PUBLIC_SITE_URL=https://gxhost.com.br

# Google login (OpenID Connect). Register this exact callback URL in the
# Google Cloud OAuth client; leave all three blank to keep Google login off.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.gxhost.com.br/api/auth/google/callback

BILLING_WEBHOOK_SECRET=

ASSISTANT_PROVIDER=kb
ASSISTANT_LLM_API_KEY=
MODRINTH_USER_AGENT=gxhost/hosting-panel/0.1.0

# Without these, password-reset emails only get logged by the API
# (MailService's degrade-gracefully fallback) instead of actually sent —
# fine for a soft launch, but worth setting before real customers rely
# on "esqueci minha senha".
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@gxhost.com.br
MAIL_FROM_NAME=GXhost

ALLOW_PUBLIC_REGISTRATION=false

# ---- public-exposure plan (docs/PUBLIC-EXPOSURE.md) ----
# Also consumed directly by docker-compose.prod.yml's `gateway` service
# (its GATEWAY_TOKEN) — one value, two env names, since they're two
# different processes. Leave PUBLIC_GATEWAY_TOKEN empty and never
# register a Gateway row in the admin panel to keep this feature fully
# off — every server keeps showing its plain internal ip:port.
PUBLIC_GATEWAY_TOKEN=
PUBLIC_GATEWAY_PORT_RANGE=25565-25664
PUBLIC_GATEWAY_HOSTNAME_ZONE=

# ---- GXhost's own authoritative DNS (docs/DNS-POWERDNS.md) ----
# 'none' (default) never touches DNS — every server keeps showing plain
# ip:port, no domain required. 'powerdns' additionally requires the 3
# vars below and a real ns1/ns2 delegation at the registrar — see that
# doc's own step-by-step before flipping this in production.
PUBLIC_GATEWAY_DNS_PROVIDER=none
# A zona que o PowerDNS realmente hospeda — NEM SEMPRE igual a
# PUBLIC_GATEWAY_HOSTNAME_ZONE acima, e confundir as duas já derrubou o
# DNS inteiro em produção (404 em todo registro, silencioso porque a
# sincronia de DNS é best-effort). Os hostnames saem como
# `<shortId>.mc.<PUBLIC_GATEWAY_HOSTNAME_ZONE>`, ou seja aquela var é o
# domínio raiz (gxhost.com.br); esta aqui é a zona delegada aos ns da
# GXhost, que no setup recomendado é só o subdomínio de jogo
# (mc.gxhost.com.br) — assim o raiz continua servindo site/painel/API de
# onde já está. Vazio ⇒ cai em PUBLIC_GATEWAY_HOSTNAME_ZONE, correto só
# quando o domínio raiz inteiro é delegado ao PowerDNS.
PUBLIC_GATEWAY_DNS_ZONE=mc.gxhost.com.br
# Base URL of GXhost's own PowerDNS REST API (docker-compose.prod.yml's
# `pdns` service) — e.g. http://127.0.0.1:8081 when ns1 runs on this same
# VPS, or the WireGuard address if it's ever split onto its own host.
# Never a public URL — see docs/DNS-POWERDNS.md's security section.
PUBLIC_GATEWAY_DNS_API_URL=
# PowerDNS's own API key (its PDNS_api_key / docker-compose.prod.yml's
# same var) — generate with `openssl rand -hex 32`.
PUBLIC_GATEWAY_DNS_API_TOKEN=
# PowerDNS's server id in its own REST API path — "localhost" for
# virtually every deployment (PowerDNS's own default), never a hostname.
PUBLIC_GATEWAY_DNS_SERVER_ID=localhost
# IP público desta VPS — o pdns publica a porta 53 só nesse endereço
# (evita colisão com o stub do systemd-resolved em 127.0.0.53:53).
PDNS_BIND_ADDRESS=
