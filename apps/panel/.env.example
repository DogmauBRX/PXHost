VITE_API_URL=http://localhost:3000

# Cloudflare Turnstile — the SITE key only (public, safe in a browser
# bundle). The Secret Key is a server-side value in apps/api/.env
# (TURNSTILE_SECRET_KEY) instead, never here. Unset means every
# Turnstile widget on the login/register/forgot-password pages simply
# doesn't render, and the backend skips verification too — no
# Cloudflare account needed for local dev/test.
VITE_TURNSTILE_SITE_KEY=
