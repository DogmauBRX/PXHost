NODE_ENV=development
PORT=3000

# app_user is RLS-restricted (created by prisma/migrations/0002_rls_policies)
DATABASE_URL=postgresql://app_user:pxhost_app_dev@localhost:5432/pxhost_dev?schema=public
# table-owner role; used only by `prisma migrate`, never at runtime
DIRECT_DATABASE_URL=postgresql://pxhost:pxhost_dev@localhost:5432/pxhost_dev?schema=public
REDIS_URL=redis://localhost:6379
# Separate logical DB from the cache above — BullMQ's own bookkeeping (architecture doc 3.7)
QUEUE_REDIS_URL=redis://localhost:6379/1

# 32 random bytes, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
APP_KEY=
APP_KEY_VERSION=1
JWT_SESSION_SECRET=

# base64 of a Go-format ed25519.PrivateKey (32-byte seed || 32-byte pubkey):
# `cd agent && go run ./hack/devtoken keygen --out-dir /tmp/k && cat /tmp/k/panel-ed25519.key`
# Distribute the matching .pub (base64, 32 raw bytes) to every node as panel_public_key_path.
PANEL_ED25519_PRIVATE_KEY=

PANEL_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Client-features Fase 8 — which AssistantProvider answers assistant chat.
# 'kb' (default) needs no key. 'llm' without ASSISTANT_LLM_API_KEY falls
# back to 'kb' with a boot warning instead of failing to start.
ASSISTANT_PROVIDER=kb
ASSISTANT_LLM_API_KEY=

# Client account management Fase 1 — generic SMTP for password-reset
# emails. All optional: unset means MailService logs the reset link
# instead of sending (see env.schema.ts's comment) — nothing to configure
# for local dev/test.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@gxhost.local
MAIL_FROM_NAME=GXhost

# Anti-bot for login/register/forgot-password (Cloudflare Turnstile).
# Optional — unset means verification is skipped entirely, same as
# never having added this feature at all; nothing else to configure for
# local dev/test. Get this from the Cloudflare dashboard's Turnstile
# section (add "localhost" as an allowed domain for local dev). The
# SITE key (public) is a SEPARATE var in the panel's own build —
# VITE_TURNSTILE_SITE_KEY, apps/panel/.env — never here.
TURNSTILE_SECRET_KEY=

# Commercial site (subscriptions plan) — public self-signup
# (POST /api/auth/register). Defaults to false: an existing deployment's
# behavior never changes on upgrade, only an admin can create a user
# until an operator explicitly sets this to true.
ALLOW_PUBLIC_REGISTRATION=false

# Canonical public origin for SEO (canonical URLs, sitemap.xml, OG tags).
# Optional — defaults to PANEL_URL, which is correct as long as the
# commercial site and the panel share an origin.
PUBLIC_SITE_URL=

# Payments plan — Asaas (migrated from Mercado Pago 2026-09). All
# optional: unset means this deployment hasn't opted into real payments
# yet; the checkout endpoint refuses (503) at request time rather than
# failing to boot. Get the API key from Asaas's own dashboard
# (Integrações > Chaves de API) — sandbox and production are genuinely
# separate environments with separate keys; a sandbox key never works
# in production and vice versa.
ASAAS_API_KEY=
# 'sandbox' (default, safe) or 'production'. A deployment that forgets
# to set this talks to sandbox, never accidentally to production.
ASAAS_ENVIRONMENT=sandbox
# Override for the base URL — normally unset; AsaasClient derives the
# real URL from ASAAS_ENVIRONMENT alone. Only needed for something
# unusual (a proxy, a mock server in CI).
ASAAS_BASE_URL=
# The static token configured in Asaas's own dashboard (Integrações >
# Webhooks), compared with timingSafeEqual against the
# `asaas-access-token` header on every notification.
ASAAS_WEBHOOK_TOKEN=

# Inadimplência: days between a subscription's due date and the server
# actually being suspended for non-payment.
BILLING_GRACE_DAYS=3
# How long an abandoned checkout (a `pending` order) holds its
# subscription's slot before the billing-cycle job expires it.
CHECKOUT_ORDER_TTL_MINUTES=1440
