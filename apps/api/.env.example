NODE_ENV=development
PORT=3000

# app_user is RLS-restricted (created by prisma/migrations/0002_rls_policies)
DATABASE_URL=postgresql://app_user:pxhost_app_dev@localhost:5432/pxhost_dev?schema=public
# table-owner role; used only by `prisma migrate`, never at runtime
DIRECT_DATABASE_URL=postgresql://pxhost:pxhost_dev@localhost:5432/pxhost_dev?schema=public
REDIS_URL=redis://localhost:6379
# Separate logical DB from the cache above — BullMQ's own bookkeeping (architecture doc 3.7)
QUEUE_REDIS_URL=redis://localhost:6379/1

# 32 random bytes, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
APP_KEY=
APP_KEY_VERSION=1
JWT_SESSION_SECRET=

# base64 of a Go-format ed25519.PrivateKey (32-byte seed || 32-byte pubkey):
# `cd agent && go run ./hack/devtoken keygen --out-dir /tmp/k && cat /tmp/k/panel-ed25519.key`
# Distribute the matching .pub (base64, 32 raw bytes) to every node as panel_public_key_path.
PANEL_ED25519_PRIVATE_KEY=

PANEL_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional — HMAC key for the external payment webhook (architecture doc
# roadmap M14). Unset means this deployment hasn't opted into billing
# hooks; POST /api/billing/webhook refuses every event (503) rather than
# accepting one it can't verify.
BILLING_WEBHOOK_SECRET=

# Client-features Fase 8 — which AssistantProvider answers assistant chat.
# 'kb' (default) needs no key. 'llm' without ASSISTANT_LLM_API_KEY falls
# back to 'kb' with a boot warning instead of failing to start.
ASSISTANT_PROVIDER=kb
ASSISTANT_LLM_API_KEY=
