// GXhost Panel API — Prisma schema (M3: data foundation + identity).
// Full v1 domain model per docs/ARCHITECTURE.md section 2. Status columns
// are modelled as String, not native Postgres ENUM: values map 1:1 to
// TypeScript string unions, and CHECK constraints (added in a follow-up
// SQL migration, see prisma/migrations) can be dropped/re-added
// transactionally, unlike ALTER TYPE ... ADD VALUE.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: the app's own connection, as the restricted "app_user"
// role — subject to Row-Level Security on tenant-owned tables (see
// migrations/0002_rls_policies). DIRECT_DATABASE_URL: the migration/owner
// role, which Prisma Migrate uses to create/alter schema (RLS-restricted
// app_user could never run DDL or the RLS-setup migration itself). This
// is Prisma's standard pooler-bypass mechanism, repurposed here for a
// privilege split instead of a connection-pooler bypass.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────── IDENTITY ───────────────────────────

model User {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String    @db.Citext
  username          String    @db.Citext
  passwordHash      String    @map("password_hash")
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  language          String    @default("pt-BR")
  timezone          String    @default("America/Sao_Paulo")
  globalRole        String    @default("user") @map("global_role")
  adminPermissions  String[]  @default([]) @map("admin_permissions")
  totpSecretEnc     Bytes?    @map("totp_secret_enc")
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz
  recoveryCodesEnc  Bytes?    @map("recovery_codes_enc")
  isActive          Boolean   @default(true) @map("is_active")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  failedLogins      Int       @default(0) @map("failed_logins") @db.SmallInt
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  tokensValidAfter  DateTime  @default(now()) @map("tokens_valid_after") @db.Timestamptz
  // Billing profile — collected at checkout time (CreateSubscriptionDto
  // never accepts these; SubscriptionsService.createForUser reads them
  // straight off this row, see that method's own doc comment), never at
  // signup (RegisterForm.tsx stays name/email/password-only — "commercial
  // plan §8: don't ask for what isn't needed yet"). All nullable: most
  // rows have none until their owner actually subscribes to something.
  // billingCountry defaults 'BR' but isn't editable from the client yet
  // — cpf itself is Brazil-specific, so there's nothing else to select
  // today; the column exists so a future non-BR billing profile doesn't
  // need its own migration.
  cpf                       String?   @db.VarChar(11)
  billingPostalCode         String?   @map("billing_postal_code") @db.VarChar(8)
  billingAddressLine        String?   @map("billing_address_line")
  billingAddressNumber      String?   @map("billing_address_number")
  billingAddressComplement  String?   @map("billing_address_complement")
  billingNeighborhood       String?   @map("billing_neighborhood")
  billingCity               String?   @map("billing_city")
  billingState              String?   @map("billing_state") @db.VarChar(2)
  billingCountry            String?   @default("BR") @map("billing_country") @db.VarChar(2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  sessions       Session[]
  apiKeys        ApiKey[]
  ownedServers   Server[]        @relation("ServerOwner")
  subusers       Subuser[]       @relation("SubuserUser")
  invitedSubs    Subuser[]       @relation("SubuserInvitedBy")
  auditActor     AuditLog[]      @relation("AuditActor")
  activity       ActivityLog[]   @relation("ActivityActor")
  createdTokens  NodeToken[]     @relation("NodeTokenCreatedBy")
  subscriptions  Subscription[]
  subscriptionEventsActedOn SubscriptionEvent[] @relation("SubscriptionEventActor")
  orders         Order[]
  paymentCustomers PaymentCustomer[]
  oauthIdentities OAuthIdentity[]
  friendshipsSent     Friendship[]      @relation("FriendshipRequester")
  friendshipsReceived Friendship[]      @relation("FriendshipAddressee")
  communityServers    CommunityServer[]
  supportTickets      SupportTicket[]       @relation("SupportTicketOwner")
  supportMessages     SupportTicketMessage[] @relation("SupportMessageAuthor")

  @@map("users")
}

// Social graph for GXHost customers. `pairKey` is the two user UUIDs in
// lexical order, so reverse requests cannot create a duplicate friendship.
model Friendship {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pairKey     String    @unique @map("pair_key")
  requesterId String    @map("requester_id") @db.Uuid
  addresseeId String    @map("addressee_id") @db.Uuid
  status      String    @default("pending")
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

// Deliberately denormalized directory row: authenticated customers can
// discover a published server without gaining RLS access to its Server row.
// The owner can only create/update it through SocialService, which derives
// every field from a server they own and an active public gateway route.
model CommunityServer {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serverId    String   @unique @map("server_id") @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  description String   @default("")
  address     String
  software    String?
  version     String?
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([publishedAt])
  @@map("community_servers")
}

model Session {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  refreshHash  String    @map("refresh_hash")
  familyId     String    @default(dbgenerated("uuidv7()")) @map("family_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?   @db.Inet
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  usedAt       DateTime? @map("used_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiKey {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  keyType      String    @default("account") @map("key_type")
  identifier   String    @unique @db.Char(16)
  tokenHash    String    @map("token_hash")
  memo         String    @default("")
  scopes       String[]  @default([])
  allowedIps   String[]  @default([]) @map("allowed_ips")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model PermissionCatalog {
  key         String  @id
  scope       String
  groupKey    String  @map("group_key")
  i18nKey     String  @map("i18n_key")
  isDangerous Boolean @default(false) @map("is_dangerous")
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("permission_catalog")
}

// ─────────────────────── INFRASTRUCTURE ────────────────────────

model Location {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shortCode  String    @map("short_code")
  name       String
  country    String?   @db.Char(2)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  nodes Node[]

  @@map("locations")
}

model Node {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId               String    @map("location_id") @db.Uuid
  name                     String
  description              String?
  fqdn                     String
  scheme                   String    @default("https")
  daemonPort               Int       @default(8443) @map("daemon_port")
  // Deploy plan — the panel↔agent CONTROL-PLANE origin, when it differs
  // from what the browser uses (fqdn/scheme/daemonPort above, which stay
  // the customer's direct console/file/backup target — see wsUrl's own
  // doc comment, "never proxied through this API"). In the WireGuard
  // topology this holds the node's private tunnel address (e.g.
  // "http://10.10.0.2:8443") so AgentClientService reaches it over the
  // VPN instead of the public hostname, while the browser keeps using
  // the public fqdn unchanged. NULL (every node's default, including
  // every dev/test node) means "same as the browser" — AgentClientService
  // .baseURL falls back to scheme://fqdn:daemonPort exactly as it always
  // has, so this column changes nothing until an admin sets it.
  controlAddress           String?   @map("control_address")
  // Public-exposure plan — the node's own address on the WireGuard tunnel
  // (e.g. "10.10.0.2"), as structured data. `controlAddress` above already
  // embeds this same IP inside a URL for the panel->agent control plane;
  // this column exists so the gateway reconciler (GatewayService, which
  // has no reason to parse a control-plane URL) can read it directly when
  // rendering a PublicRoute's proxy target. NULL (every node's default)
  // means "this node is not reachable from the gateway yet" — a server on
  // such a node simply never gets a PublicRoute reconciled to 'active';
  // nothing else in the app (capacity, provisioning, the agent) reads it.
  tunnelIp                 String?   @db.Inet @map("tunnel_ip")
  sftpPort                 Int       @default(2022) @map("sftp_port")
  daemonDataPath           String    @default("/var/lib/pxhost/volumes") @map("daemon_data_path")
  behindProxy              Boolean   @default(false) @map("behind_proxy")
  isPublic                 Boolean   @default(true) @map("is_public")
  maintenanceMode          Boolean   @default(false) @map("maintenance_mode")
  // A future heads-up, distinct from `maintenanceMode` itself (which
  // means "in maintenance right NOW"). Nullable/optional and purely
  // informational — nothing in capacity math, scheduling, or the
  // create/transfer capacity gates ever reads this column; only
  // PublicStatusService does, to annotate a location's public status
  // with "entra em manutenção em X" ahead of time. An admin setting
  // `maintenanceMode=true` does NOT auto-clear this — the public read
  // side simply stops surfacing it once the location's overall status
  // is already 'maintenance' (see that service's own doc comment), so a
  // stale value here is harmless either way.
  maintenanceScheduledAt   DateTime? @map("maintenance_scheduled_at") @db.Timestamptz
  memoryTotalMb            Int       @map("memory_total_mb")
  memoryReservedMb         Int       @default(0) @map("memory_reserved_mb")
  memoryOverallocatePct    Int       @default(0) @map("memory_overallocate_pct")
  diskTotalMb              Int       @map("disk_total_mb")
  diskReservedMb           Int       @default(0) @map("disk_reserved_mb")
  diskOverallocatePct      Int       @default(0) @map("disk_overallocate_pct")
  cpuTotalPercent          Int       @default(0) @map("cpu_total_percent")
  cpuReservedPercent       Int       @default(0) @map("cpu_reserved_percent")
  cpuOverallocatePct       Int       @default(-1) @map("cpu_overallocate_pct")
  uploadSizeMb             Int       @default(256) @map("upload_size_mb")
  // Placement policy — reserves this node for plans priced at or above
  // this amount, in cents (same unit as Plan.priceCents). The point is
  // "set once, forever correct": a pricier plan added LATER automatically
  // prefers this node too, with no per-plan configuration — contrast
  // PlanNode.priority/restriction, which is an explicit, auditable
  // decision about one specific plan→node pair. NULL (every node's
  // default) means no reservation, normal worst-fit scoring applies
  // unchanged. The two are independent and both apply: a plan explicitly
  // allowed onto this node via PlanNode still needs to clear this
  // threshold too, if set — see NodeSchedulerService.selectNode.
  reservedForPlansAbovePriceCents Int? @map("reserved_for_plans_above_price_cents")
  // Capacity plan (auto-derivation) — 'manual' is the only mode every
  // node created before this migration keeps behaving as: the DECLARED
  // columns above stay the ceiling, unchanged. 'auto' is opt-in per
  // node; CapacityService.resolveNodeCapacity is the one place that
  // reads this to decide whether a dimension's total/reserved comes
  // from the columns above or from reported telemetry below — nothing
  // else branches on it. See nodes_capacity_mode_check.
  capacityMode             String    @default("manual") @map("capacity_mode")
  // Safety margin applied ON TOP OF the admin reserve above, only in
  // 'auto' mode — folded into resolveNodeCapacity's effective `reserved`
  // before it ever reaches ceilingFor, so ceilingFor/assertCapacity/
  // headroomFor/snapshotDimension need no changes at all. Defaults (10%,
  // 10%, 10%) are this feature's own global default — there is no
  // settings table in this schema (every other cross-cutting config
  // lives as env vars or, like this, as a per-row column with its
  // @default acting as the effective global default).
  memorySafetyMarginPct    Int       @default(10) @map("memory_safety_margin_pct")
  diskSafetyMarginPct      Int       @default(10) @map("disk_safety_margin_pct")
  cpuSafetyMarginPct       Int       @default(10) @map("cpu_safety_margin_pct")
  // Usage-percent thresholds for capacityStatus's 4 levels (normal/
  // warning/high/critical) — same "column default = global default"
  // posture as the safety margins above. Applies in both capacity
  // modes (a manual node's admin may still want custom alert levels).
  capacityWarnPct          Int       @default(70) @map("capacity_warn_pct")
  capacityHighPct          Int       @default(85) @map("capacity_high_pct")
  capacityCriticalPct      Int       @default(95) @map("capacity_critical_pct")
  healthStatus             String    @default("unknown") @map("health_status")
  lastHeartbeatAt          DateTime? @map("last_heartbeat_at") @db.Timestamptz
  agentVersion             String?   @map("agent_version")
  dockerVersion             String?   @map("docker_version")
  // Capacity plan Fase 2: what the agent ACTUALLY reports about its host,
  // strictly separate from the declared commercial-capacity columns
  // above — never copied into them, and never written to directly by
  // anything but a heartbeat. All nullable: no agent sends these yet
  // (that wiring is Fase 7), and an old agent's heartbeat must keep
  // working with these left NULL forever if it's never upgraded.
  //
  // In 'manual' capacityMode (every node's default) these stay exactly
  // what the field names always said: purely informational display data,
  // never read by capacity.math.ts. In 'auto' mode, resolveNodeCapacity
  // reads reportedMemoryLimitMb (falling back to reportedMemoryTotalMb),
  // reportedDiskTotalMb, and reportedCpuCount as the dimension's total —
  // the only three fields on this whole model that cross from "reported"
  // into "enforced," and only for nodes that opted in.
  reportedMemoryTotalMb    Int?      @map("reported_memory_total_mb")
  // The node's OWN cgroup memory limit (v2 memory.max / v1
  // memory.limit_in_bytes), distinct from reportedMemoryTotalMb (the
  // Docker daemon's host-wide MemTotal). Inside an LXC guest without
  // lxcfs, MemTotal reports the PROXMOX HOST's full RAM, not the
  // guest's share — this field is what actually lets 'auto' mode sell
  // the guest's real capacity instead of the host's. NULL for an agent
  // older than this milestone, or when cgroup is genuinely unlimited —
  // resolveNodeCapacity falls back to reportedMemoryTotalMb in both
  // cases, same as it always effectively has.
  reportedMemoryLimitMb    Int?      @map("reported_memory_limit_mb")
  reportedCpuCount         Int?      @map("reported_cpu_count")
  reportedDiskTotalMb      Int?      @map("reported_disk_total_mb")
  reportedDiskFreeMb       Int?      @map("reported_disk_free_mb")
  reportedOs               String?   @map("reported_os")
  reportedKernel           String?   @map("reported_kernel")
  reportedContainersRunning Int?     @map("reported_containers_running")
  reportedAt               DateTime? @map("reported_at") @db.Timestamptz
  agentUptimeSeconds        Int?     @map("agent_uptime_seconds")
  // Automatic hardware-capacity detection: deeper host telemetry than the
  // block above ever collected (CPU model/topology, current usage/load,
  // memory used/available, virtualization). Purely informational/display
  // — never enters capacity math (capacity.math.ts/capacity.service.ts
  // are 100% based on the DECLARED columns above), and never enters
  // deriveTelemetryDivergence's declared×reported comparison, which stays
  // scoped to memory/disk/cpu totals only. reportedCpuPhysicalCores/
  // reportedCpuSockets are deliberately left NULL by the agent when it
  // detects it's running inside an LXC container (see agent's
  // internal/hostinfo package) — /proc/cpuinfo isn't namespaced there, so
  // reporting them would leak the HOST's physical topology into what
  // should be the guest's own capacity.
  reportedCpuModel             String?  @map("reported_cpu_model")
  reportedCpuSockets           Int?     @map("reported_cpu_sockets")
  reportedCpuPhysicalCores     Int?     @map("reported_cpu_physical_cores")
  reportedCpuUsagePercent      Int?     @map("reported_cpu_usage_percent")
  reportedLoadAvg1             Float?   @map("reported_load_avg_1")
  reportedMemoryUsedMb         Int?     @map("reported_memory_used_mb")
  reportedMemoryAvailableMb    Int?     @map("reported_memory_available_mb")
  reportedVirtualizationSystem String?  @map("reported_virtualization_system")
  reportedVirtualizationRole   String?  @map("reported_virtualization_role")
  // Encrypted (reversible, CryptoService/AES-256-GCM) copy of the SAME
  // secret issued to the agent as its node_token during bootstrap
  // (node_tokens.token_hash holds an argon2id hash of it, for verifying
  // AGENT->PANEL calls). This column exists so the PANEL can also
  // authenticate PANEL->AGENT control-plane calls (create server, power
  // actions) with that identical credential, without a second bootstrap
  // round trip. It's a deliberate interim simplification pending full
  // mTLS (architecture doc 3.4 layer 1, explicitly deferred in the M4
  // README) — one shared secret, used in both directions, verified
  // structurally differently on each end (hash comparison on the panel
  // for inbound; local-file comparison on the agent for inbound; this
  // encrypted copy purely so the panel has *something* to present
  // outbound). Never returned by any API response.
  controlTokenEnc          Bytes?    @map("control_token_enc")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz

  location    Location     @relation(fields: [locationId], references: [id])
  allocations Allocation[]
  servers     Server[]
  tokens      NodeToken[]
  dbHosts     DatabaseHost[]
  mounts      MountNode[]
  plans       PlanNode[]
  transfersFrom ServerTransfer[] @relation("TransferSource")
  transfersTo   ServerTransfer[] @relation("TransferTarget")

  @@map("nodes")
}

model NodeToken {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nodeId      String    @map("node_id") @db.Uuid
  tokenId     String    @map("token_id") @db.Char(16)
  tokenHash   String    @map("token_hash")
  status      String    @default("active")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  node    Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  creator User? @relation("NodeTokenCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([tokenId])
  @@map("node_tokens")
}

// Capability-token signing keys (architecture doc 3.4: "signing keys
// carry next/current/retiring states, published in the JWKS 24h before
// promotion, retired 24h after"). Rotation in this milestone (roadmap
// M13) is admin-triggered rather than time-scheduled — see
// SigningKeysService's doc comment — so this schema only needs
// current/retiring/retired, not a separate "next" row: rotate() both
// creates AND promotes the new key in the same call.
model SigningKey {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kid           String    @unique
  publicKey     String    @map("public_key") // base64, raw 32-byte Ed25519 public key
  privateKeyEnc Bytes?    @map("private_key_enc") // AES-256-GCM envelope-encrypted seed+pub; null once retired — a retired key can still verify old tokens via publicKey, but must never sign a new one
  state         String    @default("current") // current | retiring | retired
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  promotedAt    DateTime? @map("promoted_at") @db.Timestamptz
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz

  @@map("signing_keys")
}

model Allocation {
  id        BigInt   @id @default(autoincrement())
  nodeId    String   @map("node_id") @db.Uuid
  ip        String   @db.Inet
  ipAlias   String?  @map("ip_alias")
  port      Int
  serverId  String?  @map("server_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  node   Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@unique([nodeId, ip, port])
  @@map("allocations")
}

// Public-exposure plan — a VPS gateway that terminates public game traffic
// and forwards it, over WireGuard, to the node that actually holds the
// container (GatewayService/GatewayDriver, apps/api/src/modules/gateway).
// Deliberately its own table rather than reusing Node: a gateway is not a
// hosting node (no capacity, no allocations, no agent) and this repo's
// nodes.* vocabulary already means something specific. Modeled as a table,
// not a single env-configured row, so a second gateway is a data problem
// (add a row) rather than a code problem (roadmap: HA / multi-region).
model Gateway {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  // The hostname/IP a customer's client actually connects to — what a
  // PublicRoute's port is opened ON. Never a private/tunnel address.
  publicHost    String    @map("public_host")
  // This gateway's OWN address on the WireGuard tunnel (e.g. "10.10.0.1")
  // — the source a node's firewall must allow game/control traffic FROM.
  // Purely informational today (nothing dials it); documented here so the
  // firewall rules in deploy/node/firewall.sh have one place that names
  // where that IP comes from.
  tunnelIp      String    @db.Inet @map("tunnel_ip")
  // Base URL of this gateway's own control API (the small sidecar in
  // apps/gateway, NOT the WireGuard/nginx data path) — what
  // HttpGatewayDriver calls to push/fetch desired routes. e.g.
  // "http://10.10.0.1:9443".
  controlUrl    String    @map("control_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastAppliedAt DateTime? @map("last_applied_at") @db.Timestamptz
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  routes PublicRoute[]

  @@map("gateways")
}

// One row per exposed server (public-exposure plan). Deliberately keyed on
// Server, not Allocation: the public port must survive a node transfer
// (TransfersService.handleResult swaps which Allocation a server owns, but
// the customer's public endpoint should not silently change), and the
// actual proxy TARGET (node.tunnelIp + the server's current primary
// allocation ip/port) is derived at reconcile time, never stored here —
// storing it would let this row drift from the allocation it's supposed to
// mirror. `state` is this row's own lifecycle, independent of the
// server's: a gateway outage leaves `state='failed'` while the server
// itself stays perfectly healthy (GatewayReconcileProcessor's doc comment).
model PublicRoute {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  gatewayId  String    @map("gateway_id") @db.Uuid
  serverId   String    @unique @map("server_id") @db.Uuid
  publicPort Int       @map("public_port")
  protocol   String    @default("tcp")
  // pending: created, not yet pushed to the gateway.
  // active: last reconcile confirmed the gateway has this exact route.
  // failed: last reconcile attempt errored — lastError explains why; the
  //   server and its allocation are completely untouched by this.
  // removing: server deleted (or route superseded) — the reconciler drops
  //   it from the gateway's desired set, then deletes this row for real.
  state      String    @default("pending")
  lastError  String?   @map("last_error")
  appliedAt  DateTime? @map("applied_at") @db.Timestamptz
  // Custom-hostname plan — a customer-chosen LABEL only (e.g. "survival"),
  // never the full FQDN; composed with PUBLIC_GATEWAY_HOSTNAME_ZONE at
  // read/reconcile time via public-address.ts's deriveCustomHostname,
  // same "store the identity, derive the string" split deriveHostname
  // already uses for shortId. Nullable + globally UNIQUE (not per-owner
  // — Postgres allows multiple NULLs under a unique index, same pattern
  // Subscription.serverId already uses) so two different customers can
  // never claim the same address, and a server with no custom hostname
  // keeps using the shortId-derived `.mc.` scheme unchanged.
  customHostname     String?   @unique @map("custom_hostname")
  // Internal bookkeeping ONLY — never returned to a customer. The exact
  // FQDN (custom or shortId-derived) DNS was last successfully synced
  // for, so the reconciler can tell a rename/clear apart from "nothing
  // changed" and remove the OLD record instead of leaking it forever.
  // NULL = DNS has never been successfully synced for this route.
  dnsSyncedHostname  String?   @map("dns_synced_hostname")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  server  Server  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // A gateway can only ever bind one public port once — the real backstop
  // against two servers ending up with the same public endpoint, the same
  // role @@unique([nodeId, ip, port]) plays for internal Allocations above.
  @@unique([gatewayId, publicPort])
  @@index([state])
  @@map("public_routes")
}

model Mount {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  description    String?
  sourcePath     String   @map("source_path")
  targetPath     String   @map("target_path")
  isReadOnly     Boolean  @default(true) @map("is_read_only")
  userMountable  Boolean  @default(false) @map("user_mountable")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  nodes     MountNode[]
  templates MountTemplate[]
  servers   ServerMount[]

  @@map("mounts")
}

model MountNode {
  mountId String @map("mount_id") @db.Uuid
  nodeId  String @map("node_id") @db.Uuid

  mount Mount @relation(fields: [mountId], references: [id], onDelete: Cascade)
  node  Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([mountId, nodeId])
  @@map("mount_nodes")
}

model MountTemplate {
  mountId    String @map("mount_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid

  mount    Mount          @relation(fields: [mountId], references: [id], onDelete: Cascade)
  template ServerTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([mountId, templateId])
  @@map("mount_templates")
}

model ServerMount {
  serverId String @map("server_id") @db.Uuid
  mountId  String @map("mount_id") @db.Uuid

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  mount  Mount  @relation(fields: [mountId], references: [id], onDelete: Cascade)

  @@id([serverId, mountId])
  @@map("server_mounts")
}

// ────────────────────────── CATALOG ────────────────────────────

model TemplateGroup {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  description String?
  iconUrl     String?   @map("icon_url")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  templates ServerTemplate[]

  @@map("template_groups")
}

model ServerTemplate {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId           String    @map("group_id") @db.Uuid
  parentId          String?   @map("parent_id") @db.Uuid
  name              String
  author            String
  description       String?
  dockerImages      Json      @map("docker_images")
  startupCommand    String    @map("startup_command")
  stopCommand       String    @default("stop") @map("stop_command")
  configFiles       Json      @default("{}") @map("config_files")
  configStartup     Json      @default("{}") @map("config_startup")
  configLogs        Json      @default("{}") @map("config_logs")
  installImage      String    @default("ghcr.io/parkervcp/installers:debian") @map("install_image")
  installEntrypoint String    @default("bash") @map("install_entrypoint")
  installScript     String    @map("install_script")
  // The single canonical software signal (Paper/Fabric/Forge/...), used to
  // pick the right addon directory (M-client-features roadmap) and to keep
  // the assistant from ever giving software-incompatible instructions.
  // Nullable: null means "nobody has classified this template yet," which
  // degrades to "no addon guidance available," not a wrong guess.
  softwareKind      String?   @map("software_kind")
  forceOutgoingIp   Boolean   @default(false) @map("force_outgoing_ip")
  isActive          Boolean   @default(true) @map("is_active")
  // Customer-facing visibility (payments plan §1) — deliberately separate
  // from `isActive` (an admin-only "usable at all" switch): a template can
  // be active-but-internal (isPublic=false, still assignable by an admin)
  // or active-and-public (sellable through the customer checkout). Default
  // false so no existing/admin-created template turns public by accident.
  isPublic          Boolean   @default(false) @map("is_public")
  // Display order in the public catalog only; irrelevant to admin listing
  // (which orders by name).
  sortOrder         Int       @default(0) @map("sort_order")
  iconUrl           String?   @map("icon_url")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  group     TemplateGroup          @relation(fields: [groupId], references: [id])
  parent    ServerTemplate?        @relation("TemplateParent", fields: [parentId], references: [id])
  children  ServerTemplate[]       @relation("TemplateParent")
  variables TemplateVariable[]
  servers   Server[]
  mounts    MountTemplate[]

  @@map("server_templates")
}

model TemplateVariable {
  id               BigInt   @id @default(autoincrement())
  templateId       String   @map("template_id") @db.Uuid
  name             String
  description      String?
  envVariable      String   @map("env_variable")
  defaultValue     String   @default("") @map("default_value")
  rules            String   @default("nullable|string")
  isUserViewable   Boolean  @default(true) @map("is_user_viewable")
  isUserEditable   Boolean  @default(true) @map("is_user_editable")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  template       ServerTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serverValues   ServerVariable[]

  @@unique([templateId, envVariable])
  @@map("template_variables")
}

model Plan {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                  String
  slug                  String
  description           String?
  isPublic              Boolean   @default(true) @map("is_public")
  sortOrder             Int       @default(0) @map("sort_order")
  cpuLimitPercent       Int       @default(100) @map("cpu_limit_percent")
  cpuPinning            String    @default("") @map("cpu_pinning")
  memoryMb              Int       @map("memory_mb")
  swapMb                Int       @default(0) @map("swap_mb")
  diskMb                Int       @map("disk_mb")
  ioWeight              Int       @default(500) @map("io_weight")
  blockIoReadBps        BigInt    @default(0) @map("block_io_read_bps")
  blockIoWriteBps       BigInt    @default(0) @map("block_io_write_bps")
  oomKillEnabled        Boolean   @default(false) @map("oom_kill_enabled")
  maxDatabases          Int       @default(0) @map("max_databases")
  maxBackups            Int       @default(0) @map("max_backups")
  maxAllocations        Int       @default(1) @map("max_allocations")
  maxSchedules          Int       @default(5) @map("max_schedules")
  backupRetentionDays   Int       @default(7) @map("backup_retention_days")
  // Commercial stock (capacity plan Fase 4) — NULL means unlimited slots
  // (every plan created before this migration reads as unlimited, zero
  // behavior change), 0 means sold out without deleting or hiding the
  // plan. Occupancy is deliberately NOT a stored counter here — it's
  // `count(servers WHERE plan_id = X AND status <> 'deleting')`,
  // computed the same way CapacityService.usageForNode excludes
  // `deleting`, so a slot and a unit of capacity can never disagree.
  // Servers are hard-deleted with no lifecycle hook that could keep a
  // stored counter honest, which is exactly why this is derived, not
  // stored.
  maxSlots              Int?      @map("max_slots")
  priceCents            Int       @default(0) @map("price_cents")
  // Commercial site — an optional anchor "de" price shown struck-through
  // next to priceCents on the public card, with the discount percentage
  // computed at render time (never stored). Admin-set and admin-only:
  // there is no coupon/promo-code system (deliberately out of scope —
  // see the commercial plan's §34), so this is a single number the
  // admin can raise/lower/clear like any other plan field, not a time-
  // boxed campaign. Null (the default — every existing plan reads this
  // way) means "no anchor price," and the card shows only priceCents,
  // unchanged from before this column existed.
  compareAtPriceCents   Int?      @map("compare_at_price_cents")
  currency              String    @default("BRL") @db.Char(3)
  billingPeriod         String    @default("monthly") @map("billing_period")
  // Checkout redesign (WHMCS-style) — the ONLY link between billing-cycle
  // variations of the same product (e.g. "Básico mensal" and "Básico
  // trimestral" are two separate Plan rows with the same planFamily).
  // Nullable: a plan with no family (or the only member of its family)
  // is simply a single-cycle product, rendered as a single card by the
  // public checkout — see migration 0030_plan_family's own comment for
  // the backfill that makes every pre-existing plan its own family.
  planFamily            String?   @map("plan_family")
  // Advisory metadata only — never enforced, never copied onto Server, and
  // deliberately absent from PlansService.DRIFTABLE_FIELDS. These describe
  // the plan in prose for the customer ("we recommend ~30-80 mods"), not a
  // technical limit; a server never "drifts" from a recommendation. All
  // nullable: null means the plan simply doesn't publish that range, which
  // renders as nothing on the client rather than a fake "0-0".
  recommendedPlayersMin Int?      @map("recommended_players_min")
  recommendedPlayersMax Int?      @map("recommended_players_max")
  recommendedModsMin    Int?      @map("recommended_mods_min")
  recommendedModsMax    Int?      @map("recommended_mods_max")
  recommendedPluginsMin Int?      @map("recommended_plugins_min")
  recommendedPluginsMax Int?      @map("recommended_plugins_max")
  // Customer-facing hardware name (for example "AMD Ryzen 9 7900X").
  // Display metadata only: scheduling and capacity continue to use the
  // plan/node relations and the node's reported resources.
  hardwareLabel         String?   @map("hardware_label")
  // Display-only today: clients cannot create servers (only admins can), so
  // there is no self-service flow for this to gate. Surfaced on "Meu Plano"
  // as information, not enforced anywhere.
  maxServers            Int?      @map("max_servers")
  // Commercial site (subscriptions) — an admin-picked highlight, same
  // opt-in posture as PlanNode's eligibility list: a plan is never
  // algorithmically decided "most popular", the admin says so explicitly
  // via /admin/plans. highlightLabel is the badge text on the public
  // card ("Mais popular", "Melhor custo-benefício", ...); null with
  // isFeatured true just means "highlighted, no custom label" — the
  // public catalog falls back to a default label in that case.
  isFeatured            Boolean   @default(false) @map("is_featured")
  highlightLabel        String?   @map("highlight_label")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz

  servers       Server[]
  nodes         PlanNode[]
  subscriptions Subscription[]
  orders        Order[]

  @@map("plans")
}

// Which nodes a plan may be scheduled onto (capacity plan Fase 4/5) —
// same join-table shape as `MountNode`/`mount_nodes`. A plan with NO
// rows here is eligible on every node (opt-in restriction, no backfill
// needed for any existing plan). `priority` is the scheduler's
// (Fase 5) tie-breaker, read-only from every other angle.
model PlanNode {
  planId   String @map("plan_id") @db.Uuid
  nodeId   String @map("node_id") @db.Uuid
  priority Int    @default(0)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([planId, nodeId])
  @@map("plan_nodes")
}

// ───────────────────────── SERVERS ─────────────────────────────

model Server {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shortId            String    @unique @map("short_id") @db.Char(8)
  ownerId            String    @map("owner_id") @db.Uuid
  nodeId             String    @map("node_id") @db.Uuid
  // Nullable: a server born from post-purchase provisioning (Order ->
  // Subscription auto-provisioning) reserves its plan slot and node
  // RAM/disk/CPU/allocation/uid immediately — CapacityService only ever
  // filters on `status <> 'deleting'`, never on this column — but starts
  // life with no software chosen yet (`status: 'setup_pending'`). It
  // becomes permanently non-null the moment the customer completes setup
  // and status leaves 'setup_pending' — enforced together with
  // dockerImage/startupCommand by `servers_setup_consistency` below, the
  // same biconditional-CHECK posture `servers_suspension_consistency`
  // already uses for suspendedAt.
  templateId         String?   @map("template_id") @db.Uuid
  planId             String?   @map("plan_id") @db.Uuid
  // Per-node container uid (maps to the Linux uid the agent runs the
  // container as and chowns its bind-mounted data directory to — see
  // fsx.Jail on the agent side). Nullable because it was never persisted
  // before capacity Fase 1: every pre-existing row keeps whatever uid its
  // already-running container has, which nothing here needs to re-derive.
  // Every NEW row gets a real value from CapacityService.nextUid, computed
  // as `max(uid) + 1` per node under the node's advisory lock — replacing
  // the previous `UID_BASE + count(servers)` approximation, which reused
  // an already-used uid the instant any server on that node was
  // hard-deleted (Server.Remove() on the agent deliberately never deletes
  // the data directory, so a reused uid is a real tenant-isolation risk,
  // not a cosmetic one).
  uid                Int?
  name               String
  description        String    @default("")
  // NULL exactly when templateId is NULL — see templateId's own doc
  // comment and servers_setup_consistency.
  dockerImage        String?   @map("docker_image")
  startupCommand     String?   @map("startup_command")
  cpuLimitPercent    Int       @default(100) @map("cpu_limit_percent")
  cpuPinning         String    @default("") @map("cpu_pinning")
  memoryMb           Int       @map("memory_mb")
  swapMb             Int       @default(0) @map("swap_mb")
  diskMb             Int       @map("disk_mb")
  ioWeight           Int       @default(500) @map("io_weight")
  blockIoReadBps     BigInt    @default(0) @map("block_io_read_bps")
  blockIoWriteBps    BigInt    @default(0) @map("block_io_write_bps")
  oomKillEnabled     Boolean   @default(false) @map("oom_kill_enabled")
  maxDatabases       Int       @default(0) @map("max_databases")
  maxBackups         Int       @default(0) @map("max_backups")
  maxAllocations     Int       @default(1) @map("max_allocations")
  maxSchedules       Int       @default(5) @map("max_schedules")
  status             String    @default("installing")
  suspendedAt        DateTime? @map("suspended_at") @db.Timestamptz
  suspensionReason   String?   @map("suspension_reason")
  // 'admin' (a human via ServersController) or 'billing' (billing-cycle
  // / the payments webhook, actorId: null). The ONLY thing that lets
  // ServersService.unsuspend refuse to undo an admin suspension just
  // because a payment came in — before this column, unsuspend() was
  // unconditional and any caller could reactivate ANY suspended server.
  // NULL whenever suspendedAt is NULL (mirrors that column's own
  // consistency CHECK).
  suspensionSource   String?   @map("suspension_source")
  powerState         String    @default("offline") @map("power_state")
  powerStateAt       DateTime  @default(now()) @map("power_state_at") @db.Timestamptz
  lastDiskUsedMb     Int       @default(0) @map("last_disk_used_mb")
  installedAt        DateTime? @map("installed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  owner    User            @relation("ServerOwner", fields: [ownerId], references: [id])
  node     Node            @relation(fields: [nodeId], references: [id])
  template ServerTemplate? @relation(fields: [templateId], references: [id])
  plan     Plan?           @relation(fields: [planId], references: [id])

  allocations Allocation[]
  variables   ServerVariable[]
  subusers    Subuser[]
  databases   Database[]
  schedules   Schedule[]
  mounts      ServerMount[]
  activity    ActivityLog[]
  transfers   ServerTransfer[]
  metrics     ServerMetric1m[]
  // Nullable, unique on the Subscription side (a server has at most one
  // subscription) — see Subscription.serverId's doc comment. NULL for any
  // server an admin still creates directly; non-null the moment
  // ServersService.createSetupPending attaches it, at payment
  // confirmation — before the customer has even chosen software, which
  // is exactly why this attach and the template snapshot are two
  // separate steps now (see the 'setup_pending' status and
  // ServerSetupService.complete).
  subscription  Subscription?
  communityListing CommunityServer?
  supportTickets   SupportTicket[]
  // Same shape as `subscription` above, one level up the chain: the
  // Order that paid for this server, once ProvisioningService attaches
  // it. NULL for every server created outside the checkout flow
  // (admin-created directly, or created before this milestone).
  order         Order?
  // Public-exposure plan — see PublicRoute's own doc comment for why this
  // is keyed on Server rather than Allocation. Optional: a server with no
  // row here (the default) is simply never exposed publicly, exactly
  // today's behavior.
  publicRoute   PublicRoute?
  modpackInstallations ModpackInstallation[]

  @@map("servers")
}

// A provider subject is immutable and is the only safe identity key to
// persist. Email is retained as helpful metadata, but is never used to
// authenticate a Google sign-in on its own.
model OAuthIdentity {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  email           String?  @db.Citext
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([provider, userId])
  @@index([userId])
  @@map("oauth_identities")
}

model ModpackInstallation {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serverId         String    @map("server_id") @db.Uuid
  requestedBy      String    @map("requested_by") @db.Uuid
  source           String
  projectId        String    @map("project_id")
  versionId        String    @map("version_id")
  projectName      String    @map("project_name")
  versionName      String    @map("version_name")
  minecraftVersion String    @map("minecraft_version")
  loader           String
  status           String    @default("pending")
  progress         Int       @default(0)
  message          String?
  backupId         String?   @map("backup_id")
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@map("modpack_installations")
}

model ServerVariable {
  id         BigInt   @id @default(autoincrement())
  serverId   String   @map("server_id") @db.Uuid
  variableId BigInt   @map("variable_id")
  value      String   @default("")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  server   Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  variable TemplateVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@unique([serverId, variableId])
  @@map("server_variables")
}

model Subuser {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serverId    String    @map("server_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  permissions String[]  @default([])
  invitedBy   String?   @map("invited_by") @db.Uuid
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user    User   @relation("SubuserUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User?  @relation("SubuserInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([serverId, userId])
  @@map("subusers")
}

// ────────────────────── SERVER SERVICES ────────────────────────

model DatabaseHost {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  host          String
  port          Int       @default(3306)
  username      String
  passwordEnc   Bytes     @map("password_enc")
  keyVersion    Int       @default(1) @map("key_version") @db.SmallInt
  nodeId        String?   @map("node_id") @db.Uuid
  maxDatabases  Int       @default(0) @map("max_databases")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  node      Node?      @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  databases Database[]

  @@map("database_hosts")
}

model Database {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serverId        String   @map("server_id") @db.Uuid
  hostId          String   @map("host_id") @db.Uuid
  database        String
  username        String
  passwordEnc     Bytes    @map("password_enc")
  keyVersion      Int      @default(1) @map("key_version") @db.SmallInt
  remote          String   @default("%")
  maxConnections  Int      @default(0) @map("max_connections")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  server Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  host   DatabaseHost @relation(fields: [hostId], references: [id], onDelete: Restrict)

  @@unique([hostId, database])
  @@unique([hostId, username])
  @@map("databases")
}

model Schedule {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serverId         String    @map("server_id") @db.Uuid
  name             String
  cronMinute       String    @default("*") @map("cron_minute")
  cronHour         String    @default("*") @map("cron_hour")
  cronDayOfMonth   String    @default("*") @map("cron_day_of_month")
  cronMonth        String    @default("*") @map("cron_month")
  cronDayOfWeek    String    @default("*") @map("cron_day_of_week")
  timezone         String    @default("America/Sao_Paulo")
  isActive         Boolean   @default(true) @map("is_active")
  onlyWhenOnline   Boolean   @default(false) @map("only_when_online")
  isProcessing     Boolean   @default(false) @map("is_processing")
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz
  lastRunStatus    String?   @map("last_run_status")
  nextRunAt        DateTime  @map("next_run_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@map("schedules")
}

model Task {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scheduleId          String   @map("schedule_id") @db.Uuid
  sequenceNumber      Int      @map("sequence_number")
  action              String
  payload             String   @default("")
  timeOffsetSeconds   Int      @default(0) @map("time_offset_seconds")
  continueOnFailure   Boolean  @default(false) @map("continue_on_failure")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, sequenceNumber])
  @@map("tasks")
}

model ServerTransfer {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serverId            String    @map("server_id") @db.Uuid
  sourceNodeId        String    @map("source_node_id") @db.Uuid
  targetNodeId        String    @map("target_node_id") @db.Uuid
  targetAllocationId  BigInt?   @map("target_allocation_id")
  // Same "decided under lock at pipeline-start, consumed at result-time"
  // shape as targetAllocationId: TransfersService.runPipeline picks the
  // target node's next uid (CapacityService.nextUid, under that node's
  // advisory lock) and bakes it into the container the target agent
  // actually creates — handleResult persists this SAME value onto
  // servers.uid when the transfer succeeds, so the stored uid always
  // matches the uid the running container was created with.
  targetUid           Int?      @map("target_uid")
  status              String    @default("pending")
  errorMessage        String?   @map("error_message")
  startedAt           DateTime? @map("started_at") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  server     Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  sourceNode Node   @relation("TransferSource", fields: [sourceNodeId], references: [id])
  targetNode Node   @relation("TransferTarget", fields: [targetNodeId], references: [id])

  @@map("server_transfers")
}

// ────────────────────── OBSERVABILITY ──────────────────────────

model ActivityLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String   @default("user") @map("actor_type")
  serverId   String?  @map("server_id") @db.Uuid
  event      String
  ip         String?  @db.Inet
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor  User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// audit_logs and server_metrics_1m are partitioned tables (RANGE by
// occurred_at / bucket) — Prisma models the parent shape; partitions are
// created by the raw-SQL migration alongside the RLS policies, since
// Prisma's schema DSL has no partitioning syntax.
model AuditLog {
  id           BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  actorId      String?  @map("actor_id") @db.Uuid
  actorEmail   String?  @map("actor_email")
  actorIp      String?  @map("actor_ip") @db.Inet
  action       String
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  metadata     Json     @default("{}")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ServerMetric1m {
  serverId    String   @map("server_id") @db.Uuid
  bucket      DateTime @db.Timestamptz
  cpuPercent  Float    @map("cpu_percent")
  memoryBytes BigInt   @map("memory_bytes")
  diskBytes   BigInt   @map("disk_bytes")
  netRxBytes  BigInt   @map("net_rx_bytes")
  netTxBytes  BigInt   @map("net_tx_bytes")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, bucket])
  @@map("server_metrics_1m")
}

// ─────────────────────── SUBSCRIPTIONS ──────────────────────────
// Commercial site (subscriptions plan): the contract between a customer
// and a plan, separate from `Server.planId`. A server links to a plan
// because it was CREATED with that plan's limits snapshotted onto it
// (architecture doc 2.1's "snapshot, not reference"); a subscription
// links a customer to a plan because they COMMERCIALLY CONTRACTED it —
// the two can exist independently (a subscription with no server yet,
// pending admin provisioning; a server with no subscription, created
// directly by an admin the old way) and are connected only by the
// optional, unique `serverId` below, deliberately left NULL by
// everything in this milestone. Auto-provisioning (turning an `active`
// subscription into a running server) is an explicitly separate,
// future milestone — see the commercial plan's §13/§35.
model Subscription {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  planId              String    @map("plan_id") @db.Uuid
  // NULL until ServersService.createSetupPending attaches a server, at
  // payment confirmation (ProvisioningService) — a bare reservation with
  // no software chosen yet, see the server's own 'setup_pending' status.
  // UNIQUE: a server is provisioned for at most one subscription, never
  // shared — application code also checks this explicitly before the
  // attach (`SUBSCRIPTION_ALREADY_HAS_SERVER:`) so a real race raises a
  // domain error instead of a raw constraint violation, but the index is
  // still the hard backstop. `onDelete: SetNull` — an admin hard-deleting
  // the server a subscription is attached to must not cascade into
  // deleting the customer's billing history.
  serverId            String?   @unique @map("server_id") @db.Uuid
  status              String    @default("pending")
  // Snapshotted at contract time — same doctrine as Server's own
  // memoryMb/diskMb/cpuLimitPercent copied from Plan at creation
  // (architecture doc 2.1). An admin editing Plan.priceCents later must
  // never silently re-price a customer's existing subscription; only a
  // new subscription (or a future, explicit "change plan" action) reads
  // the plan's current price again.
  priceCents          Int       @map("price_cents")
  currency            String    @db.Char(3)
  billingPeriod       String    @map("billing_period")
  startedAt           DateTime? @map("started_at") @db.Timestamptz
  currentPeriodEndsAt DateTime? @map("current_period_ends_at") @db.Timestamptz
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz
  cancelReason        String?   @map("cancel_reason")
  // Set by a customer cancelling an active/past_due subscription who
  // still wants their current paid period honored (payments plan §19)
  // — the subscription stays `active` and the server keeps running
  // until `currentPeriodEndsAt`, at which point billing-cycle finishes
  // the cancellation (status -> 'cancelled') instead of generating a
  // renewal order. False for an IMMEDIATE cancel (the normal path,
  // unchanged) and for every subscription created before this column
  // existed.
  cancelAtPeriodEnd   Boolean   @default(false) @map("cancel_at_period_end")
  // What the customer chose at checkout — 'pix'/'boleto' (a fresh
  // notified charge every cycle) or 'card' (provider-managed automatic
  // recurring charge). NULL for
  // every subscription created
  // before this column existed — treated identically to 'pix' by every
  // reader (manual-renewal is the only behavior that ever existed).
  paymentMethod            String?   @map("payment_method")
  // Gateway chosen when the contract was created. Renewals,
  // cancellation and reconciliation must keep using the same gateway.
  paymentProvider          String    @default("mercadopago") @map("payment_provider")
  // Provider-side recurring subscription id — card only (Mercado Pago
  // preapproval or PagBank subscription; PagBank temporarily stores the
  // hosted checkout id until subscription.initial links the real id).
  // Webhooks may look up by this id or by the server-generated Order
  // externalReference, never by amount/name.
  externalSubscriptionId   String?   @unique @map("external_subscription_id")
  // TRUE only for card: the selected provider schedules and charges a
  // real recurring subscription. FALSE for pix, because neither gateway
  // uses a recurring pix product in this integration —
  // BillingCycleProcessor generates each cycle's charge instead.
  // Either way billing-cycle applies the SAME grace period
  // (BILLING_GRACE_DAYS) once a period lapses unpaid.
  autoRenew                Boolean   @default(false) @map("auto_renew")
  // A preapproval can read "authorized" before its first charge
  // actually settles. This platform never provisions on that: it waits
  // for a real approved payment, so the flag stays false and exists
  // only for legacy rows written before that rule was established.
  firstChargePending       Boolean   @default(false) @map("first_charge_pending")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan   Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  server Server?              @relation(fields: [serverId], references: [id], onDelete: SetNull)
  events SubscriptionEvent[]
  orders Order[]

  @@index([userId, status])
  @@index([planId, status])
  @@index([status])
  @@index([paymentProvider])
  @@map("subscriptions")
}

// Append-only history of status transitions (admin's "histórico básico",
// commercial plan §16/§18) — same append-only spirit as `audit_logs`,
// but scoped to one subscription's lifecycle rather than the whole
// platform, and readable by the OWNING customer too (not admin-only).
model SubscriptionEvent {
  id             BigInt   @id @default(autoincrement())
  subscriptionId String   @map("subscription_id") @db.Uuid
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  // NULL means the system made this transition (none exist yet — every
  // transition today is admin-initiated or the customer's own cancel —
  // but a future webhook/scheduler acting without a human actor needs
  // this to stay honest rather than attributing its own action to
  // whichever admin happens to be logged in).
  actorId        String?  @map("actor_id") @db.Uuid
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor        User?        @relation("SubscriptionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@map("subscription_events")
}

// ─────────────────────── BILLING / PAYMENTS ──────────────────────────
// Payments via Mercado Pago (see PAYMENT_PROVIDER/PaymentProvider's own
// doc comment). Rows written during the 2026-09 Asaas period are kept
// as financial history and are distinguishable by their `provider`.
// `PaymentCustomer` links a User to their id on ONE provider;
// `Order` is the platform's OWN commercial pedido (what was bought, at
// what price, in what state, and what it should provision once paid);
// `Payment` is one gateway transaction against an order (an order can
// have several — a Pix that expired, then a new charge the next
// cycle); `PaymentWebhookEvent` is delivery/idempotency bookkeeping for
// inbound notifications. Nothing here is provider-specific in shape —
// swapping/adding a provider changes one class under `modules/payments/`
// (the only place allowed to import a provider's SDK/HTTP client) and
// nothing in this section.

// Links a User to their customer id on ONE payment provider. Composite-
// unique on (provider, userId): at most one provider-side customer per
// user. DORMANT under Mercado Pago, which requires no customer resource
// for either flow this platform uses (a pix charge identifies the payer
// inline, a preapproval by `payer_email`) — kept, not dropped, because
// it still holds the ids created during the Asaas period.
// Also unique on (provider, externalCustomerId) —
// the reverse lookup a reconciliation job would need. No RLS: written/
// read only by the webhook handler and OrdersService's own admin-
// equivalent RLS context, same posture `payments` already documents —
// never queried directly under a customer's own JWT context.
model PaymentCustomer {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  provider           String
  externalCustomerId String   @map("external_customer_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, userId])
  @@unique([provider, externalCustomerId])
  @@map("payment_customers")
}

model Order {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // The webhook's ONLY lookup key (payments plan's own rule: never
  // accept a notification just because amount/product name happen to
  // match). Server-generated (randomBytes), never accepted from the
  // client, and never reused.
  externalReference String @unique @map("external_reference")
  userId            String @map("user_id") @db.Uuid
  planId            String @map("plan_id") @db.Uuid
  // NULL until the Subscription is created alongside this order, in the
  // same transaction (OrdersService.createCheckoutOrder).
  subscriptionId String? @map("subscription_id") @db.Uuid
  // NULL until provisioning succeeds. UNIQUE — same "at most one" shape
  // as Subscription.serverId, and the actual idempotency guard
  // ProvisioningService relies on: a retry sees this already set and
  // no-ops instead of provisioning a second server.
  serverId    String? @unique @map("server_id") @db.Uuid
  kind        String  @default("plan_initial")
  amountCents Int     @map("amount_cents")
  currency    String  @db.Char(3)
  status      String  @default("pending")
  // 'mercadopago'. Rows written during the 2026-09 Asaas period keep
  // 'asaas' untouched, for financial history — see PaymentProvider's
  // own doc comment for why nothing outside `modules/payments/` ever
  // reads this column to decide behavior.
  provider    String  @default("mercadopago")

  // Unused by the Checkout Bricks flow (card and Pix are both created
  // without a Preference/redirect) — left in place, not removed: a
  // future non-Bricks provider integration could still populate these.
  externalPreferenceId String?   @map("external_preference_id")
  checkoutUrl          String?   @map("checkout_url")
  // The Pix QR, captured SYNCHRONOUSLY from Payment.create's own
  // response (payment_method_id: 'pix') — never regenerated on a page
  // reload, so the customer always sees the SAME QR they were first
  // shown until it's paid or expires.
  pixQrCode            String?   @map("pix_qr_code")
  pixQrCodeBase64      String?   @map("pix_qr_code_base64")
  boletoDigitableLine  String?   @map("boleto_digitable_line")
  boletoUrl            String?   @map("boleto_url")
  paymentMethod        String?   @map("payment_method")
  installments         Int?
  paidAmountCents      Int?      @map("paid_amount_cents")
  paidAt               DateTime? @map("paid_at") @db.Timestamptz
  // A `pending` order older than this stops holding its subscription's
  // slot (payments plan's billing-cycle job) — an abandoned checkout
  // must not permanently squat commercial capacity.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  provisioningStatus   String  @default("not_required") @map("provisioning_status")
  provisioningError    String? @map("provisioning_error")
  provisioningAttempts Int     @default(0) @map("provisioning_attempts")

  // Immutable snapshot of what was actually purchased — server name,
  // templateId (+ its name/group at purchase time), the requested
  // template variables, and the plan's resource numbers at purchase
  // time. An admin editing the Plan or Template later must never
  // retroactively change what an already-placed order provisions — same
  // "snapshot, not reference" doctrine Server's own plan-derived columns
  // already follow (architecture doc 2.1).
  config Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  // Admin-only "remove clutter from view" — DELETE is revoked from
  // app_user on this table entirely (0022_payments: financial history
  // is never deleted, provider change or not), so this is the ONLY way
  // an admin can make an order stop cluttering /admin/payments. The row
  // itself, every field above, and every Payment/PaymentWebhookEvent
  // pointing at it are completely untouched — `listForAdmin` is the
  // ONLY place that reads this column; nothing else in the platform
  // (webhooks, provisioning, billing-cycle) treats an archived order any
  // differently from a normal one.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  server       Server?               @relation(fields: [serverId], references: [id], onDelete: SetNull)
  payments     Payment[]
  webhookEvents PaymentWebhookEvent[]

  @@index([userId, status])
  @@index([status])
  @@index([subscriptionId])
  @@index([externalPreferenceId])
  @@map("orders")
}

// One gateway transaction per row. `id` is the PROVIDER's own payment id
// used verbatim as the primary key (same doctrine the earlier, now-
// removed billing-webhook placeholder used for its own event id) — a
// webhook redelivering the same payment hits a real unique-constraint
// violation on insert, which IS the idempotency guard, not a check the
// application has to get right on its own.
model Payment {
  id                  String    @id
  orderId             String    @map("order_id") @db.Uuid
  // The 9 statuses Mercado Pago's own docs enumerate for a payment
  // (checkout-api/response-handling/collection-results) — never a
  // provider-specific value the platform invented.
  status              String
  statusDetail        String?   @map("status_detail")
  amountCents         Int       @map("amount_cents")
  paidAmountCents     Int?      @map("paid_amount_cents")
  currency            String    @db.Char(3)
  paymentMethodId     String?   @map("payment_method_id")
  paymentTypeId       String?   @map("payment_type_id")
  installments        Int?
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz
  refundedAmountCents Int       @default(0) @map("refunded_amount_cents")
  // Sanitized snapshot of the gateway's own payment object — never card
  // number/CVV (Mercado Pago's API doesn't return those either); used
  // for admin diagnosis, never re-parsed by application logic.
  raw       Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RESTRICT, not CASCADE: financial history is permanent (payments
  // plan's own repeated rule) — an order can never be deleted out from
  // under a payment record. DB-level DELETE is also revoked on this
  // table entirely (see 0022_payments' own comment).
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// Delivery/idempotency bookkeeping for inbound notifications. `id` is
// the notification's own id (same PK-as-idempotency-key doctrine as
// `Payment.id` above): Mercado Pago retries an unacknowledged
// notification every 15 minutes (its own documented policy) — a
// redelivery hits a duplicate-key error on insert and is treated as
// already-received, never reprocessed.
model PaymentWebhookEvent {
  id          String    @id
  provider    String    @default("mercadopago")
  type        String
  action      String?
  dataId      String?   @map("data_id")
  orderId     String?   @map("order_id") @db.Uuid
  status      String    @default("received")
  error       String?
  raw         Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("payment_webhook_events")
}

// ─────────────────────── SITE CONFIGURATION ──────────────────────────

// A site-wide warning/announcement banner, admin-editable, shown to
// every visitor — logged out on the public marketing site AND logged in
// on the panel (AppShell and PublicShell each render their own copy of
// the same banner component; see AnnouncementBanner.tsx — there is no
// shared parent layout to inject it into once). Single row: no admin
// history of past announcements is kept, just the current one.
// SiteAnnouncementService finds the first row or creates a default
// (inactive, empty message) — the same find-or-create posture
// prisma/seed.ts already uses for the root admin — rather than keying
// on a magic fixed id. No RLS: like `plans`/`nodes`, this is global
// config, not per-tenant data.
model SiteAnnouncement {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  message   String    @default("")
  isActive  Boolean   @default(false) @map("is_active")
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid

  @@map("site_announcements")
}

// Customer support lives inside the panel rather than being scattered
// across email threads. A ticket belongs to exactly one customer and may
// point at one of their servers; messages retain their author even when the
// author's display name changes. RLS below is the tenant boundary.
model SupportTicket {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  serverId      String?   @map("server_id") @db.Uuid
  subject       String
  category      String
  priority      String    @default("normal")
  status        String    @default("open")
  lastMessageAt DateTime  @default(now()) @map("last_message_at") @db.Timestamptz
  closedAt      DateTime? @map("closed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user     User                   @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Restrict)
  server   Server?                @relation(fields: [serverId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([userId, lastMessageAt])
  @@index([status, priority, lastMessageAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  isStaff   Boolean  @default(false) @map("is_staff")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}
